@model RestaurantManagementSystem.Models.RoomTypeFormViewModel
@{
    ViewData["Title"] = Model.RoomType.Id > 0 ? "Edit Room Type" : "Add Room Type";
    var isEdit = Model.RoomType.Id > 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas @(isEdit ? "fa-edit" : "fa-plus") me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="RoomTypes" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Room Types
        </a>
    </div>

    <form asp-action="@(isEdit ? "EditRoomType" : "CreateRoomType")" method="post">
        @if (isEdit)
        {
            <input type="hidden" name="RoomType.Id" value="@Model.RoomType.Id" />
        }

        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-th-large me-2"></i>Room Type Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" name="RoomType.Name" class="form-control" value="@Model.RoomType.Name" required placeholder="e.g., Deluxe Room, Suite" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="RoomType.Description" class="form-control" rows="3" placeholder="Describe this room type...">@Model.RoomType.Description</textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Base Price (₹/night) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" name="RoomType.BasePrice" class="form-control" value="@Model.RoomType.BasePrice" required min="0" step="0.01" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Max Occupancy <span class="text-danger">*</span></label>
                                <select name="RoomType.MaxOccupancy" class="form-select" required>
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i" selected="@(Model.RoomType.MaxOccupancy == i)">@i guests</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bed Type</label>
                                <select name="RoomType.BedType" class="form-select">
                                    <option value="Single" selected="@(Model.RoomType.BedType == "Single")">Single</option>
                                    <option value="Double" selected="@(Model.RoomType.BedType == "Double")">Double</option>
                                    <option value="Queen" selected="@(Model.RoomType.BedType == "Queen")">Queen</option>
                                    <option value="King" selected="@(Model.RoomType.BedType == "King")">King</option>
                                    <option value="Twin" selected="@(Model.RoomType.BedType == "Twin")">Twin</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Room Size (sq ft)</label>
                                <input type="number" name="RoomType.RoomSize" class="form-control" value="@Model.RoomType.RoomSize" min="0" placeholder="e.g., 350" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Amenities</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.AllAmenities?.Any() == true)
                        {
                            @foreach (var category in Model.AllAmenities.GroupBy(a => a.Category))
                            {
                                <h6 class="mt-3 mb-2 text-muted">@category.Key</h6>
                                <div class="row">
                                    @foreach (var amenity in category)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" 
                                                       name="SelectedAmenityIds" 
                                                       value="@amenity.Id" 
                                                       id="amenity_@amenity.Id"
                                                       checked="@(Model.SelectedAmenityIds?.Contains(amenity.Id) == true)">
                                                <label class="form-check-label" for="amenity_@amenity.Id">
                                                    <i class="fas @amenity.Icon me-1 text-primary"></i>@amenity.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No amenities available</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="RoomTypes" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-1"></i> @(isEdit ? "Update Room Type" : "Add Room Type")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
