@model List<RestaurantManagementSystem.Models.RoomType>
@{
    ViewData["Title"] = "Room Types";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-th-large me-2"></i>Room Types</h2>
        <div>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Dashboard
            </a>
            <a asp-action="CreateRoomType" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Add Room Type
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var roomType in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@roomType.Name</h5>
                            <span class="badge bg-light text-primary">₹@roomType.BasePrice.ToString("N0")/night</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">@(roomType.Description ?? "No description available")</p>
                        <div class="row mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Max Occupancy</small>
                                <strong><i class="fas fa-users me-1"></i>@roomType.MaxOccupancy guests</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Bed Type</small>
                                <strong><i class="fas fa-bed me-1"></i>@roomType.BedType</strong>
                            </div>
                        </div>
                        @if (roomType.RoomSize.HasValue)
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block">Room Size</small>
                                <strong><i class="fas fa-ruler-combined me-1"></i>@roomType.RoomSize sq ft</strong>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between">
                            <a asp-action="EditRoomType" asp-route-id="@roomType.Id" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <a asp-action="Rooms" asp-route-roomTypeId="@roomType.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-door-open me-1"></i> View Rooms
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-th-large fa-4x text-muted mb-3"></i>
            <h4>No room types found</h4>
            <p class="text-muted">Add your first room type to get started.</p>
            <a asp-action="CreateRoomType" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Add Room Type
            </a>
        </div>
    }
</div>
